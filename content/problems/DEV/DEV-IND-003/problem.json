 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "形成体はノギンやコーディンを分泌する。外胚葉の細胞に作用する BMP のはたらきについて、次の場合はどうなるか。"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "ノギン・コーディンが多い部分の BMP のはたらき"
     },
     {
      "id": "2",
      "tex": "その部分が神経に分化する割合"
     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "弱まる（減る）",
    "grading": "BMP のはたらき：選ぶ{増える|減る|変わらない}=2"
   },
   {
    "id": "2",
    "tex": "増える",
    "grading": "神経への分化：選ぶ{増える|減る|変わらない}=1"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "BMP は外胚葉を表皮に分化させる。ノギン・コーディンは BMP の受容体への結合を妨げるので、形成体の近くの外胚葉は神経に分化する（神経誘導）。"
    }
   ]
  }
 ],

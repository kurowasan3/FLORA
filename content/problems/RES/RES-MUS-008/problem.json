 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "1 回の刺激では単収縮。刺激の間隔が短いと前の収縮が終わる前に次の収縮が起こり、加算されて強縮になる。私たちのふだんの筋収縮は強縮。"
    }
   ]
  }
 ],

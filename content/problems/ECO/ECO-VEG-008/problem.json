 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "年降水量が少ない地域で、気温が高い熱帯・亜熱帯に見られる、イネ科の草原に低木が点在するバイオームはどれか。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "サバンナ",
    "grading": "選ぶ{ステップ|サバンナ|砂漠|ツンドラ}=2"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "降水量が少ないと森林が成立せず草原になる。熱帯ではサバンナ、温帯ではステップ。さらに少ないと砂漠。寒冷地ではツンドラ。"
    }
   ]
  }
 ],

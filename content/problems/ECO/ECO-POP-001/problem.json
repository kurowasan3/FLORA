 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "ある池でコイを 30 匹捕まえて標識をつけて放した。数日後に 40 匹捕まえると、そのうち 6 匹に標識がついていた。この池のコイの個体数を推定せよ。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "200 匹",
    "grading": "約{200|2} [匹]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "$N=\\dfrac{30\\times40}{6}=200$ 匹。標識が外れない・個体の出入りがない・十分に混ざる、などが前提。"
    }
   ]
  }
 ],

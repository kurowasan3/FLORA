 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "純生産量 = 総生産量 − 呼吸量 = 25 − 15 = 10。成長量 = 純生産量 −（被食量 + 枯死量）= 10 − 6 = 4。極相林では成長量がほぼ 0 になる。"
    }
   ]
  }

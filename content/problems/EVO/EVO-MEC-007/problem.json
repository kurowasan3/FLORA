 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "繁殖する個体は AA（0.25）と Aa（0.5）。その中の a の頻度は $\\dfrac{0.5\\times\\frac12}{0.25+0.5}=\\dfrac{0.25}{0.75}=\\dfrac13$。潜性の致死遺伝子でも、ヘテロ接合体に残るので急にはなくならない。"
    }
   ]
  }
 ],

 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "HIV はヘルパー T 細胞に感染して破壊する。ヘルパー T 細胞は B 細胞・キラー T 細胞の両方を活性化するので、体液性免疫・細胞性免疫ともにはたらかなくなる。"
    }
   ]
  }
 ],

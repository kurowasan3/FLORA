 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "ある培養細胞の集団で、細胞 1 個あたりの DNA 量を測ると、相対値 2 の細胞が 60％、2 と 4 の間の細胞が 25％、4 の細胞が 15％であった。この細胞の細胞周期は 24 時間で、M 期は 1 時間である。G₁ 期・S 期・G₂ 期の長さはそれぞれ何時間か。"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "G₁ 期"
     },
     {
      "id": "2",
      "tex": "S 期"
     },
     {
      "id": "3",
      "tex": "G₂ 期"
     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "14.4 時間",
    "grading": "約{14.4|3} [時間]"
   },
   {
    "id": "2",
    "tex": "6 時間",
    "grading": "約{6|2} [時間]"
   },
   {
    "id": "3",

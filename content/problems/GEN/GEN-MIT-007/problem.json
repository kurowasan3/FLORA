    "grading": "約{2.6|2} [時間]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "DNA 量 2 は G₁ 期（60％ → $24\\times0.6=14.4$ 時間）、2〜4 は S 期（25％ → 6 時間）、4 は G₂ 期と M 期（15％ → 3.6 時間）。M 期が 1 時間なので G₂ 期は 2.6 時間。"
    }
   ]
  }
 ],

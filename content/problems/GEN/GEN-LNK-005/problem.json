 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "配偶子は AB:ab = 1:1。子は AABB:AaBb:aabb = 1:2:1 となり、[AB]:[ab] = 3:1。独立なら 9:3:3:1 になるので、比の違いで連鎖を見分けられる。"
    }
   ]
  }
 ],

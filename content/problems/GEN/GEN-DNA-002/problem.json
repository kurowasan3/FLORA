 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "ある生物の 2 本鎖 DNA で、A（アデニン）の割合が 30％であった。G（グアニン）の割合は何％か。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "20％",
    "grading": "約{20|2} [%]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "A = T = 30％ なので、G + C = 100 − 60 = 40％。G = C なので G = 20％。"
    }
   ]
  }
 ],
